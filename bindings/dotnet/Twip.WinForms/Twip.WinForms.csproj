<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the solution build on Linux CI; the control itself runs on Windows only. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Twip.WinForms</RootNamespace>
    <PackageId>Twip.WinForms</PackageId>
    <Version>0.1.0-alpha.1</Version> <!-- x-release-please-version -->
    <Description>A WinForms DocumentEditor control over Twip.Core.</Description>
    <Authors>Jackson Casey</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/jaxcksn/twip</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Twip.Core/Twip.Core.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <InternalsVisibleTo Include="Twip.Tests" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <EmbeddedResource Include="Cursors/*.cur" LogicalName="Twip.WinForms.Cursors.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
