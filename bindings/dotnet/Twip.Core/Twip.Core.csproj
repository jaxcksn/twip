<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net48: .NET Framework 4.8 apps, x64 (the native library is win-x64). -->
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Twip</RootNamespace>
    <PackageId>Twip.Core</PackageId>
    <Version>0.1.0</Version> <!-- x-release-please-version -->
    <Description>.NET SDK for the twip DOCX layout, editing and rendering engine. Native AOT compatible.</Description>
    <Authors>Jackson Casey</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/jaxcksn/twip</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net10.0'">true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- RS0026/RS0027: the approved surface pairs path and stream overloads that both take an optional token. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="10.0.1" />
    <Reference Include="System.Net.Http" />
    <Using Include="System.Net.Http" />
    <!-- Compile-time polyfills for the newer C# features (records, init, nullable attributes); nothing at run time. -->
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <!-- Records override Clone covariantly only where the runtime supports covariant returns. -->
    <AdditionalFiles Include="PublicAPI/$(TargetFramework)/PublicAPI.Unshipped.txt" />
    <InternalsVisibleTo Include="Twip.WinForms" />
    <InternalsVisibleTo Include="Twip.Tests" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="build/Twip.Core.targets" Pack="true" PackagePath="build/net48/" />
    <None Include="build/Twip.Core.targets" Pack="true" PackagePath="buildTransitive/net48/" />
    <!-- Filled by the release workflow: runtimes/<rid>/native/<lib>. -->
    <None Include="../runtimes/**/*" Pack="true" PackagePath="runtimes/" />
    <!-- A local build, when runtimes/ has no Windows library: the release cdylib twip-capi builds. -->
    <None Include="../../../target/release/twip.dll" Pack="true" PackagePath="runtimes/win-x64/native/"
          Condition="!Exists('../runtimes/win-x64/native/twip.dll') And Exists('../../../target/release/twip.dll')" />
    <!-- Generated at release time (licenses/notices.mjs). -->
    <None Include="../../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Condition="Exists('../../../THIRD-PARTY-NOTICES.md')" />
  </ItemGroup>
</Project>
