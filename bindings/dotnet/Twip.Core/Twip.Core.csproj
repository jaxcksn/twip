<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Twip</RootNamespace>
    <PackageId>Twip.Core</PackageId>
    <Version>0.1.0-alpha.1</Version> <!-- x-release-please-version -->
    <Description>.NET SDK for the twip DOCX layout, editing and rendering engine. Native AOT compatible.</Description>
    <Authors>Jackson Casey</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/jaxcksn/twip</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- RS0026/RS0027: the approved surface pairs path and stream overloads that both take an optional token. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <InternalsVisibleTo Include="Twip.WinForms" />
    <InternalsVisibleTo Include="Twip.Tests" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <!-- Filled by the release workflow: runtimes/<rid>/native/<lib>. -->
    <None Include="../runtimes/**/*" Pack="true" PackagePath="runtimes/" />
    <!-- A local build, when runtimes/ has no Windows library: the release cdylib twip-capi builds. -->
    <None Include="../../../target/release/twip.dll" Pack="true" PackagePath="runtimes/win-x64/native/"
          Condition="!Exists('../runtimes/win-x64/native/twip.dll') And Exists('../../../target/release/twip.dll')" />
    <!-- Generated at release time (licenses/notices.mjs). -->
    <None Include="../../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Condition="Exists('../../../THIRD-PARTY-NOTICES.md')" />
  </ItemGroup>
</Project>
