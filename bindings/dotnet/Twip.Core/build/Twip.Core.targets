<Project>
  <!-- .NET Framework apps: copy the native library next to the app. Projects that use packages.config, or that don't
       set a RuntimeIdentifier, don't get runtimes/ assets on their own. The library is x64, so the app must run as a
       64-bit process. DXC's dxcompiler.dll goes with it: the library loads it by name, from the app's folder, to
       draw with D3D12. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\runtimes\win-x64\native\twip.dll" Link="twip.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\runtimes\win-x64\native\dxcompiler.dll" Link="dxcompiler.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\runtimes\win-x64\native\dxcompiler.dll')" />
  </ItemGroup>
</Project>
