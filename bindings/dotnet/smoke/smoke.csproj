<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TwipNative Condition="$([MSBuild]::IsOSPlatform('Windows'))">twip.dll</TwipNative>
    <TwipNative Condition="$([MSBuild]::IsOSPlatform('Linux'))">libtwip.so</TwipNative>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Twip/Twip.csproj" />
    <None Include="../../hello.docx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="hello.docx" />
    <None Include="../../../target/release/$(TwipNative)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="$(TwipNative)" />
  </ItemGroup>
</Project>
