[
  {
    "matchCase": true,
    "text": "total",
    "wholeWords": false
  },
  {
    "format": {
      "font": {
        "font": "Calibri",
        "size": 11.0,
        "style": "bold"
      },
      "highlight": true,
      "highlightColor": "yellow",
      "language": "en-US",
      "noProof": false,
      "paragraph": {
        "alignment": "center",
        "keepWithNext": true
      },
      "style": "Heading1"
    },
    "ignorePunctuation": true,
    "ignoreWhiteSpace": true,
    "inSelection": true,
    "matchCase": false,
    "matchPrefix": true,
    "matchSuffix": false,
    "regex": true,
    "text": "(\\d+) days",
    "wholeWords": false,
    "wrap": false
  }
]
