{
 "id": "VIEW-JOINED-NO-MARKUP",
 "title": "No markup joins a paragraph whose mark is deleted with the next: the caret, clicks, typing and deleting work across the pair",
 "fixture": "FX-EMPTY.docx",
 "steps": [
  { "type": "First para." },
  { "key": "Enter" },
  { "type": "Second para runs on long enough to wrap onto another line of the page, so the joined pair takes two lines and the caret can move between them." },
  { "command": "review.track", "arg": "on" },
  { "command": "review.author", "arg": "Author A" },
  { "click": { "para": 0, "offset": 11 } },
  { "key": "Delete" },
  { "command": "view.markup", "arg": "none" },
  { "expect": { "caret": { "para": 1, "offset": 0, "page": 0 }, "paragraphs": 2 } },
  { "key": "ArrowLeft" },
  { "expect": { "caret": { "para": 0, "offset": 11, "page": 0 } } },
  { "key": "ArrowLeft" },
  { "expect": { "caret": { "para": 0, "offset": 10 } } },
  { "key": "End" },
  { "expect": { "caret": { "para": 1 } } },
  { "key": "Home" },
  { "expect": { "caret": { "para": 0, "offset": 0 } } },
  { "click": { "para": 0, "offset": 5 } },
  { "expect": { "caret": { "para": 0, "offset": 5 } } },
  { "key": "ArrowDown" },
  { "expect": { "caret": { "para": 1 } } },
  { "key": "ArrowUp" },
  { "expect": { "caret": { "para": 0, "offset": 5 } } },
  { "click": { "para": 1, "offset": 3 } },
  { "expect": { "caret": { "para": 1, "offset": 3 } } },
  { "type": "XY" },
  { "expect": { "caret": { "para": 1, "offset": 5 }, "text": { "1": { "starts": "SecXYond para" } } } },
  { "click": { "para": 1, "offset": 0 } },
  { "expect": { "caret": { "para": 1, "offset": 0 } } },
  { "key": "Backspace" },
  { "expect": { "caret": { "para": 0, "offset": 11, "page": 0 }, "paragraphs": 2 } },
  { "key": "Backspace" },
  {
   "expect": {
    "caret": { "para": 0, "offset": 10, "page": 0 },
    "paragraphs": 2,
    "review": {
     "stories": {
      "body": [
       {
        "text": "First para.",
        "runs": [
         { "text": "First para", "ins": null, "del": null, "move": null, "fmt": null },
         { "text": ".", "ins": null, "del": "Author A", "move": null, "fmt": null }
        ],
        "mark": { "ins": null, "del": "Author A", "move": null }
       },
       {}
      ]
     }
    }
   }
  },
  { "command": "review.track", "arg": "off" },
  { "key": "Delete" },
  { "expect": { "caret": { "para": 0, "offset": 10, "page": 0 }, "paragraphs": 2, "text": { "0": "First para" } } },
  { "key": "Delete" },
  { "expect": { "caret": { "para": 0, "offset": 10, "page": 0 }, "paragraphs": 1, "text": { "0": { "starts": "First paraSecXYond para" } } } }
 ]
}
