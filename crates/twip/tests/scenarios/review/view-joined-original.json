        }
      }
    },
    {
      "key": "End"
    },
    {
      "expect": {
        "caret": {
          "para": 1,
          "offset": 7
        }
      }
    },
    {
      "click": {
        "para": 1,
        "offset": 3
      }
    },
    {
      "expect": {
        "caret": {
          "para": 1,
          "offset": 3
        }
      }
    },
    {
      "click": {
        "para": 0,
        "offset": 10,
        "dx": -1
