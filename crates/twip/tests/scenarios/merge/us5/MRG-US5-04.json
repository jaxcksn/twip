{
  "id": "MRG-US5-04",
  "title": "Two parts in one namespace: a write by namespace alone is ambiguous; with an item_id it replaces just that part",
  "fixture": "FX-MERGE-DATA.docx",
  "methods": [
    "S"
  ],
  "steps": [
    {
      "command": {
        "type": "writeDataPart",
        "namespace": "urn:store:calc",
        "itemId": "{AAAAAAAA-0000-4000-8000-000000000001}",
        "xml": "<calc xmlns=\"urn:store:calc\"><field name=\"Cost_Plus_Fee\">Cost + Fee</field></calc>"
      }
    },
    {
      "command": {
        "type": "writeDataPart",
        "namespace": "urn:store:calc",
        "itemId": "{AAAAAAAA-0000-4000-8000-000000000002}",
        "xml": "<calc xmlns=\"urn:store:calc\"><field name=\"Cost_Plus_Fee\">Cost + Fee</field></calc>"
      },
      "expect": {
        "undo_depth": 2
      }
    },
    {
      "command": {
        "type": "writeDataPart",
        "namespace": "urn:store:calc",
        "xml": "<calc xmlns=\"urn:store:calc\"><field name=\"New_Name\">Cost + Fee</field></calc>"
      },
      "expect": {
        "answer": {
          "error": "ambiguous namespace"
        },
        "undo_depth": 2
      }
    },
    {
      "command": {
        "type": "writeDataPart",
        "namespace": "urn:store:calc",
        "itemId": "{AAAAAAAA-0000-4000-8000-000000000002}",
        "xml": "<calc xmlns=\"urn:store:calc\"><field name=\"New_Name\">Cost + Fee</field></calc>"
      },
      "expect": {
        "answer": {
          "itemId": "{AAAAAAAA-0000-4000-8000-000000000002}"
        },
        "undo_depth": 3
      }
    },
    {
      "query": {
        "q": "data",
        "namespace": "urn:store:calc"
      },
      "expect": {
        "answer": [
          {
            "item_id": "{AAAAAAAA-0000-4000-8000-000000000001}",
            "xml": "<calc xmlns=\"urn:store:calc\"><field name=\"Cost_Plus_Fee\">Cost + Fee</field></calc>"
          },
          {
            "item_id": "{AAAAAAAA-0000-4000-8000-000000000002}",
            "xml": "<calc xmlns=\"urn:store:calc\"><field name=\"New_Name\">Cost + Fee</field></calc>"
          }
        ]
      }
    }
  ]
}
