    {"command": "element.remove", "arg": {"id": "$tag:Recipient/Address"}, "expect": {"text": {"2": "Address: ."}, "elements": {"removed": 1}, "undo_depth": 2}},
    {"command": "home.undo", "expect": {"text": {"2": "Address: 1 Main St."}, "elements": {"added": 1}}},
    {"command": "home.undo", "expect": {"elements": {"added": 1}, "undo_depth": 0}}
  ]
}
