{
  "name": "protection-toc",
  "fixture": "editor/FX-outline.docx",
  "steps": [
    { "op": "open" },
    { "op": "command", "command": { "type": "insertTableOfContents" } },
    { "op": "call", "method": "find.next", "args": [{ "text": "An earlier survey found two trends." }], "result": { "found": true } },
    { "op": "command", "command": { "type": "addEditableRange" } },
    { "op": "command", "command": { "type": "setDocumentProtection", "kind": "readOnly", "enforce": true } },
    { "op": "call", "method": "find.next", "args": [{ "text": "Notice claim" }], "result": { "found": true } },
    { "op": "command", "command": { "type": "insertTableOfContents" } },
    { "op": "expectError", "code": "not-allowed" },
    { "op": "command", "command": { "type": "insertCaption", "label": "Figure" } },
    { "op": "expectError", "code": "not-allowed" },
    { "op": "command", "command": { "type": "insertCrossReference", "target": { "kind": "heading", "index": 0 }, "content": "text" } },
    { "op": "expectError", "code": "not-allowed" },
    { "op": "command", "command": { "type": "markTableOfContentsEntry", "text": "Notice", "level": 1 } },
    { "op": "expectError", "code": "not-allowed" },
    { "op": "command", "command": { "type": "updateTableOfContents", "mode": "pageNumbers" } },
    { "op": "expectError", "code": "not-allowed" },
    { "op": "command", "command": { "type": "removeTableOfContents" } },
    { "op": "expectError", "code": "not-allowed" },
    { "op": "call", "method": "commands.updateAllTablesOfContents", "args": ["pageNumbers"], "result": { "changed": 0 } },
    { "op": "command", "command": { "type": "setAutoCaption", "value": { "label": "Table" } } },
    { "op": "expectState", "match": { "autoCaption": { "label": "Table" } } },
    { "op": "call", "method": "references.tablesOfContents", "result": { "tables": [{ "index": 0 }] } },

    { "op": "call", "method": "find.next", "args": [{ "text": "survey" }], "result": { "found": true } },
    { "op": "command", "command": { "type": "insertCrossReference", "target": { "kind": "heading", "index": 0 }, "content": "text" } },
    { "op": "expectState", "match": { "history": { "undoLabel": "Insert Cross-reference" } } },
    { "op": "command", "command": { "type": "setDocumentProtection", "enforce": false } },
    { "op": "command", "command": { "type": "setDocumentProtection", "kind": "trackedChanges", "enforce": true } },
    { "op": "command", "command": { "type": "moveSelection", "by": "document", "direction": "forward" } },
    { "op": "command", "command": { "type": "insertParagraph" } },
    { "op": "command", "command": { "type": "insertTableOfContents" } },
    { "op": "expectState", "match": { "history": { "undoLabel": "Insert Table of Contents" } } },
    { "op": "expectState", "match": { "review": { "tracking": true, "counts": { "all": { "insertions": 1, "deletions": 0 } } } } }
  ]
}
