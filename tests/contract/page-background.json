{
  "name": "page-background",
  "fixture": "editor/FX-outline.docx",
  "steps": [
    { "op": "open" },
    { "op": "command", "command": { "type": "setWatermark", "value": { "kind": "text", "text": "DRAFT", "color": "#FF0000", "transparency": 30, "layout": "horizontal", "bold": true } } },
    { "op": "expectState", "match": { "page": { "watermark": { "kind": "text", "text": "DRAFT", "color": "#FF0000", "transparency": 30, "layout": "horizontal", "bold": true } } } },
    { "op": "command", "command": { "type": "setWatermark", "value": { "kind": "picture", "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==", "scale": 200, "washout": true } } },
    { "op": "expectState", "match": { "page": { "watermark": { "kind": "picture", "scale": 200, "washout": true } } } },
    { "op": "command", "command": { "type": "undo" } },
    { "op": "expectState", "match": { "page": { "watermark": { "kind": "text", "text": "DRAFT" } } } },
    { "op": "command", "command": { "type": "redo" } },
    { "op": "expectState", "match": { "page": { "watermark": { "kind": "picture" } } } },
    { "op": "command", "command": { "type": "removeWatermark" } },
    { "op": "expectState", "match": { "page": { "watermark": null } } },
    { "op": "command", "command": { "type": "setPageColor", "value": { "type": "solid", "colour": { "rgb": "#FFF2CC" } } } },
    { "op": "expectState", "match": { "page": { "background": { "type": "solid", "colour": { "rgb": "#FFF2CC" } } } } },
    { "op": "command", "command": { "type": "setPageColor", "value": { "type": "gradient", "kind": "linear", "angle": 90, "stops": [
      { "position": 0, "colour": { "rgb": "#FFFFFF" } }, { "position": 1, "colour": { "rgb": "#BDD7EE" } } ] } } },
    { "op": "expectState", "match": { "page": { "background": { "type": "gradient", "kind": "linear" } } } },
    { "op": "command", "command": { "type": "undo" } },
    { "op": "expectState", "match": { "page": { "background": { "type": "solid" } } } },
    { "op": "command", "command": { "type": "setPageColor", "value": { "type": "none" } } },
    { "op": "expectState", "match": { "page": { "background": null } } },
    { "op": "call", "method": "dialogs.open", "args": ["printedWatermark"], "result": { "values": { "kind": "printedWatermark", "watermark": "none" }, "fields": { "picture": { "kind": "picture" } } } },
    { "op": "call", "method": "dialogs.open", "args": ["fillEffects"], "result": { "values": { "tab": "gradient" } } },
    { "op": "command", "command": { "type": "setWatermark", "value": { "kind": "text", "text": "" } } },
    { "op": "expectError", "code": "invalid-argument" }
  ]
