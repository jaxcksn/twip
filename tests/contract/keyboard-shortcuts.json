{
  "name": "keyboard-shortcuts",
  "fixture": "editor/FX-EMPTY.docx",
  "steps": [
    { "op": "open" },
    { "op": "text", "text": "One" },
    { "op": "key", "key": "Enter" },
    { "op": "text", "text": "Two" },
    { "op": "key", "key": "Enter" },
    { "op": "text", "text": "Three" },
    { "op": "click", "text": "Two" },
    { "op": "key", "key": "ArrowUp", "mods": ["alt", "shift"] },
    { "op": "expectState", "match": { "history": { "undoLabel": "Move Paragraphs" } } },
    { "op": "command", "command": { "type": "selectAll" } },
    { "op": "expectState", "match": { "selection": { "text": "Two\nOne\nThree" } } },
    { "op": "command", "command": { "type": "undo" } },
    { "op": "command", "command": { "type": "selectAll" } },
    { "op": "expectState", "match": { "selection": { "text": "One\nTwo\nThree" } } },

    { "op": "key", "key": "8", "mods": ["ctrl", "shift"] },
    { "op": "expectState", "match": { "view": { "formattingMarks": true } } },
    { "op": "key", "key": "8", "mods": ["ctrl", "shift"] },
    { "op": "expectState", "match": { "view": { "formattingMarks": false } } },

    { "op": "call", "method": "find.next", "args": [{ "text": "Three" }], "result": { "found": true } },
    { "op": "command", "command": { "type": "setFontSize", "value": 11 } },
    { "op": "key", "key": "]", "mods": ["ctrl"] },
    { "op": "expectState", "match": { "formatting": { "size": 12 } } },
    { "op": "key", "key": "[", "mods": ["ctrl"] },
    { "op": "key", "key": "[", "mods": ["ctrl"] },
    { "op": "expectState", "match": { "formatting": { "size": 10 } } },

    { "op": "click", "text": "One" },
    { "op": "key", "key": "t", "mods": ["ctrl"] },
    { "op": "expectState", "match": { "paragraph": { "indents": { "left": 36, "hanging": 36 } }, "history": { "undoLabel": "Hanging Indent" } } },
    { "op": "key", "key": "t", "mods": ["ctrl", "shift"] },
    { "op": "expectState", "match": { "paragraph": { "indents": { "left": 0 } } } },
    { "op": "command", "command": { "type": "setAlignment", "value": "center" } },
    { "op": "key", "key": "q", "mods": ["ctrl"] },
    { "op": "expectState", "match": { "paragraph": { "alignment": "left" }, "history": { "undoLabel": "Reset Paragraph" } } },

    { "op": "call", "method": "find.next", "args": [{ "text": "Two" }], "result": { "found": true } },
    { "op": "command", "command": { "type": "setBold", "value": true } },
    { "op": "command", "command": { "type": "clearAllFormatting" } },
    { "op": "expectState", "match": { "formatting": { "bold": false }, "history": { "undoLabel": "Clear Formatting" } } },

    { "op": "key", "key": "End", "mods": ["ctrl"] },
    { "op": "key", "key": "Enter" },
    { "op": "text", "text": "U+00e9" },
    { "op": "key", "key": "x", "mods": ["alt"] },
    { "op": "call", "method": "find.next", "args": [{ "text": "é" }], "result": { "found": true } },
    { "op": "key", "key": "End" },
    { "op": "key", "key": "x", "mods": ["alt"] },
    { "op": "call", "method": "find.next", "args": [{ "text": "00E9" }], "result": { "found": true } },

    { "op": "key", "key": "End", "mods": ["ctrl"] },
    { "op": "key", "key": "t", "mods": ["ctrl", "alt"] },
    { "op": "call", "method": "find.next", "args": [{ "text": "™" }], "result": { "found": true } },

    { "op": "key", "key": "End", "mods": ["ctrl"] },
    { "op": "key", "key": "Enter" },
    { "op": "text", "text": "Head body" },
    { "op": "key", "key": "Home" },
    { "op": "repeat", "count": 4, "step": { "op": "key", "key": "ArrowRight" } },
    { "op": "key", "key": "Enter", "mods": ["ctrl", "alt"] },
    { "op": "expectState", "match": { "history": { "undoLabel": "Style Separator" } } },
    { "op": "call", "method": "elements.structure", "result": { "$has": [{ "kind": "paragraph", "textLength": 4, "hiddenMarks": [{ "at": 4, "styleSeparator": true }] }] } },

    { "op": "key", "key": "End", "mods": ["ctrl"] },
    { "op": "key", "key": "d", "mods": ["alt", "shift"] },
    { "op": "key", "key": "Home", "mods": ["ctrl"] },
    { "op": "key", "key": "F11" },
    { "op": "expectState", "match": { "selection": { "empty": false, "context": [{ "kind": "field" }] } } },

    { "op": "call", "method": "find.next", "args": [{ "text": "One" }], "result": { "found": true } },
    { "op": "key", "key": "c", "mods": ["ctrl", "shift"] },
    { "op": "expectState", "match": { "commands": { "pasteFormatting": { "enabled": true } } } },
    { "op": "key", "key": "m", "mods": ["ctrl", "alt"] },
    { "op": "expectState", "match": { "review": { "comments": 1 } } }
  ]
}
