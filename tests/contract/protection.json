{
  "name": "protection",
  "fixture": "editor/FX-outline.docx",
  "steps": [
    { "op": "open" },
    { "op": "call", "method": "find.next", "args": [{ "text": "survey" }], "result": { "found": true } },
    { "op": "command", "command": { "type": "addEditableRange" } },
    { "op": "command", "command": { "type": "setDocumentProtection", "kind": "readOnly", "enforce": true, "password": "secret" } },
    { "op": "expectState", "match": { "review": { "protection": { "kind": "readOnly", "enforced": true, "password": true, "inEditableRange": true } } } },
    { "op": "command", "command": { "type": "insertText", "value": "the " } },
    { "op": "command", "command": { "type": "setDocumentProperties", "title": "Changed" } },
    { "op": "expectError", "code": "not-allowed" },
    { "op": "call", "method": "find.next", "args": [{ "text": "Data" }], "result": { "found": true } },
    { "op": "command", "command": { "type": "insertText", "value": "x" } },
    { "op": "expectError", "code": "not-allowed" },
    { "op": "command", "command": { "type": "setDocumentProtection", "enforce": false, "password": "wrong" } },
    { "op": "expectError", "code": "not-allowed" },
    { "op": "export", "format": "docx" },
    { "op": "reopen" },
    { "op": "expectState", "match": { "review": { "protection": { "kind": "readOnly", "enforced": true, "password": true } } } },
    { "op": "command", "command": { "type": "setDocumentProtection", "enforce": false, "password": "secret" } },
    { "op": "expectState", "match": { "review": { "protection": { "enforced": false, "password": false } } } },
    { "op": "command", "command": { "type": "insertText", "value": "x" } },
    { "op": "call", "method": "find.next", "args": [{ "text": "survey" }], "result": { "found": true } },
    { "op": "command", "command": { "type": "removeEditableRanges" } },
    { "op": "expectState", "match": { "review": { "protection": { "inEditableRange": false } } } }
  ]
}
