{
  "name": "controls-api",
  "steps": [
    { "op": "call", "method": "commands.insertControl", "args": [{ "kind": "date", "options": { "format": "MMMM yyyy", "calendar": "hijri", "storeAs": "text" } }],
      "save": "date", "result": { "id": { "$type": "string" } } },
    { "op": "call", "method": "elements.get", "args": [{ "$saved": "date", "path": ["id"] }],
      "result": { "kind": "date", "options": { "format": "MMMM yyyy", "calendar": "hijri", "storeAs": "text" } } },
    { "op": "command", "command": { "type": "setControl", "id": { "$saved": "date", "path": ["id"] }, "options": { "calendar": "gregorian", "storeAs": "dateTime" } } },
    { "op": "call", "method": "elements.get", "args": [{ "$saved": "date", "path": ["id"] }], "result": { "options": { "calendar": "gregorian", "storeAs": "dateTime" } } },
    { "op": "command", "command": { "type": "fillControl", "id": { "$saved": "date", "path": ["id"] }, "date": "2027-02-03" } },
    { "op": "call", "method": "elements.get", "args": [{ "$saved": "date", "path": ["id"] }], "result": { "display": "February 2027", "date": "2027-02-03T00:00:00Z" } },
    { "op": "command", "command": { "type": "fillControl", "id": { "$saved": "date", "path": ["id"] }, "date": "soon" } },
    { "op": "expectError", "code": "invalid-argument" },
    { "op": "command", "command": { "type": "fillControl", "id": { "$saved": "date", "path": ["id"] }, "text": "a", "date": "2027-01-01" } },
    { "op": "expectError", "code": "invalid-argument" },

    { "op": "command", "command": { "type": "moveSelection", "by": "document", "direction": "forward" } },
    { "op": "command", "command": { "type": "insertParagraph" } },
    { "op": "call", "method": "commands.insertControl", "args": [{ "kind": "buildingBlockGallery", "options": { "gallery": "Quick Parts", "category": "General" } }], "save": "gal" },
    { "op": "call", "method": "elements.get", "args": [{ "$saved": "gal", "path": ["id"] }],
      "result": { "kind": "buildingBlockGallery", "display": "Choose a building block.", "options": { "gallery": "Quick Parts", "category": "General" } } },
    { "op": "command", "command": { "type": "setControl", "id": { "$saved": "gal", "path": ["id"] }, "options": { "category": "Other" } } },
    { "op": "call", "method": "elements.get", "args": [{ "$saved": "gal", "path": ["id"] }], "result": { "options": { "gallery": "Quick Parts", "category": "Other" } } },
    { "op": "command", "command": { "type": "insertControl", "kind": "citation" } },
    { "op": "expectError", "code": "invalid-argument" },

    { "op": "command", "command": { "type": "moveSelection", "by": "document", "direction": "forward" } },
    { "op": "command", "command": { "type": "insertParagraph" } },
    { "op": "command", "command": { "type": "insertText", "value": "Item" } },
    { "op": "command", "command": { "type": "select", "value": "paragraph" } },
    { "op": "call", "method": "commands.wrapInRepeatingSection", "args": [{}], "save": "rs" },
    { "op": "call", "method": "commands.addRepeatingItem", "args": [{ "id": { "$saved": "rs", "path": ["id"] } }], "result": { "id": { "$type": "string" } } },
    { "op": "call", "method": "elements.get", "args": [{ "$saved": "rs", "path": ["id"] }], "result": { "kind": "repeatingSection", "children": [{ "$type": "string" }, { "$type": "string" }] } },
    { "op": "expectState", "match": { "history": { "undoLabel": "Insert Item" } } },
    { "op": "command", "command": { "type": "undo" } },
    { "op": "command", "command": { "type": "setControl", "id": { "$saved": "rs", "path": ["id"] }, "options": { "allowInsertDelete": false } } },
    { "op": "command", "command": { "type": "addRepeatingItem", "id": { "$saved": "rs", "path": ["id"] } } },
    { "op": "expectError", "code": "unavailable" },
    { "op": "command", "command": { "type": "addRepeatingItem", "id": { "$saved": "date", "path": ["id"] } } },
    { "op": "expectError", "code": "invalid-argument" },

    { "op": "command", "command": { "type": "moveSelection", "by": "document", "direction": "forward" } },
    { "op": "command", "command": { "type": "insertParagraph" } },
    { "op": "command", "command": { "type": "insertFormField", "value": "checkBox" } },
    { "op": "command", "command": { "type": "selectField", "value": "previous" } },
    { "op": "command", "command": { "type": "setFormField", "entryMacro": "A", "helpText": "Tip", "helpIsAutoText": true, "checkBox": { "size": 12, "checkedByDefault": true } } },
    { "op": "expectState", "match": { "selection": { "context": [{ "kind": "field", "locked": false, "showingCode": false, "dirty": false,
      "form": { "kind": "checkBox", "entryMacro": "A", "helpText": "Tip", "helpIsAutoText": true, "statusIsAutoText": false, "size": 12, "checkedByDefault": true } }] } } },
    { "op": "command", "command": { "type": "setFormField", "checkBox": { "size": "auto" } } },
    { "op": "expectState", "match": { "selection": { "context": [{ "form": { "size": "auto" } }] } } }
  ]
}
