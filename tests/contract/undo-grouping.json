{
  "name": "undo-grouping",
  "fixture": "editor/FX-EMPTY.docx",
  "steps": [
    { "op": "open" },
    { "op": "text", "text": "Hello" },
    { "op": "text", "text": " wor" },
    { "op": "text", "text": "ld" },
    { "op": "key", "key": "Enter" },
    { "op": "text", "text": "Next" },
    { "op": "text", "text": " line" },
    { "op": "expectEvents", "match": [
      { "type": "documentChanged", "origin": "user", "revision": 2 },
      { "type": "documentChanged", "origin": "user", "revision": 3 },
      { "type": "documentChanged", "origin": "user", "revision": 4 },
      { "type": "documentChanged", "origin": "user", "revision": 5 },
      { "type": "documentChanged", "origin": "user", "revision": 6 },
      { "type": "documentChanged", "origin": "user", "revision": 7 }
    ] },
    { "op": "command", "command": { "type": "undo" } },
    { "op": "call", "method": "find.next", "args": [{ "text": "Next" }], "result": { "found": false } },
    { "op": "call", "method": "find.next", "args": [{ "text": "Hello world" }], "result": { "found": true } },
    { "op": "expectState", "match": { "revision": 8, "history": { "canUndo": true } } },
    { "op": "command", "command": { "type": "undo" } },
    { "op": "call", "method": "find.next", "args": [{ "text": "Hello world" }], "result": { "found": true } },
    { "op": "expectState", "match": { "revision": 9, "history": { "canUndo": true } } },
    { "op": "command", "command": { "type": "undo" } },
    { "op": "call", "method": "find.next", "args": [{ "text": "Hello" }], "result": { "found": false } },
    { "op": "expectState", "match": { "revision": 10, "history": { "canUndo": false, "canRedo": true } } },
    { "op": "key", "key": "y", "mods": ["ctrl"] },
    { "op": "call", "method": "find.next", "args": [{ "text": "Hello" }], "result": { "found": true } },
    { "op": "expectState", "match": { "history": { "canUndo": true } } },
    { "op": "command", "command": { "type": "selectAll" } },
    { "op": "command", "command": { "type": "setBold", "value": true } },
    { "op": "command", "command": { "type": "setItalic", "value": true } },
    { "op": "call", "method": "historyLabels", "args": [{ "limit": 2 }], "result": { "undo": { "$exact": ["Italic", "Bold"] }, "moreUndo": true, "redo": { "$exact": [] }, "moreRedo": false } },
    { "op": "command", "command": { "type": "undo", "count": 2 } },
    { "op": "expectState", "match": { "formatting": { "bold": false, "italic": false }, "history": { "canRedo": true, "redoLabel": "Bold" } } },
    { "op": "call", "method": "historyLabels", "result": { "redo": { "$exact": ["Bold", "Italic"] } } },
    { "op": "command", "command": { "type": "redo", "count": 5 } },
    { "op": "expectState", "match": { "formatting": { "bold": true, "italic": true }, "history": { "canRedo": false } } }
  ]
}
