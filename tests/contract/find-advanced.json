{
  "name": "find-advanced",
  "fixture": "editor/FX-EMPTY.docx",
  "steps": [
    { "op": "open" },
    { "op": "command", "command": { "type": "insertText", "value": "Order 12 of 345 apples." } },
    { "op": "command", "command": { "type": "insertParagraph" } },
    { "op": "command", "command": { "type": "insertText", "value": "apple pie, re-apply" } },
    { "op": "command", "command": { "type": "insertParagraph" } },
    { "op": "command", "command": { "type": "insertText", "value": "The end." } },

    { "op": "call", "method": "find.all", "args": [{ "text": "^#^#" }], "result": { "matches": [
      { "id": { "$type": "string" }, "before": "Order ", "text": "12", "after": " of 345 apples.", "page": 1 },
      { "id": { "$type": "string" }, "before": "Order 12 of ", "text": "34", "after": "5 apples.", "page": 1 }
    ] } },
    { "op": "call", "method": "find.all", "args": [{ "text": "apples.^p" }], "save": "across", "result": { "matches": [{ "text": "apples. ", "after": "apple pie, re-apply" }] } },
    { "op": "call", "method": "find.select", "args": [{ "$saved": "across", "path": ["matches", 0, "id"] }] },
    { "op": "expectState", "match": { "selection": { "kind": "text", "empty": false } } },
    { "op": "call", "method": "find.all", "args": [{ "text": "\\d+", "regex": true }], "result": { "matches": [{ "text": "12" }, { "text": "345" }] } },
    { "op": "call", "method": "find.replaceAll", "args": [{ "text": "(\\d+)", "regex": true }, "<$1>"], "result": { "count": 2 } },
    { "op": "call", "method": "find.all", "args": [{ "text": "<12>" }], "result": { "matches": [{ "text": "<12>", "after": " of <345> apples." }] } },
    { "op": "command", "command": { "type": "undo" } },
    { "op": "call", "method": "find.all", "args": [{ "text": "<12>" }], "result": { "matches": { "$exact": [] } } },
    { "op": "call", "method": "find.all", "args": [{ "text": "^p" }], "result": { "matches": [{}, {}] } },
    { "op": "call", "method": "find.replaceAll", "args": [{ "text": "^p" }, " "], "result": { "count": 2 } },
    { "op": "call", "method": "find.all", "args": [{ "text": "apples. apple pie" }], "result": { "matches": [{ "text": "apples. apple pie" }] } },
    { "op": "command", "command": { "type": "undo" } },
    { "op": "call", "method": "find.all", "args": [{ "text": "apples. apple pie" }], "result": { "matches": { "$exact": [] } } },

    { "op": "call", "method": "find.next", "args": [{ "text": "a[", "regex": true }] },
    { "op": "expectError", "code": "invalid-argument" },
    { "op": "call", "method": "find.next", "args": [{ "text": "^q" }] },
    { "op": "expectError", "code": "invalid-argument" },
    { "op": "call", "method": "find.replaceAll", "args": [{ "text": "apple" }, "^&^&^c^q"] },
    { "op": "expectError", "code": "invalid-argument" },

    { "op": "command", "command": { "type": "moveSelection", "by": "document", "direction": "forward" } },
    { "op": "call", "method": "find.next", "args": [{ "text": "apple", "wrap": false }], "result": { "found": false, "wrapped": false } },
    { "op": "call", "method": "find.next", "args": [{ "text": "apple" }], "result": { "found": true, "wrapped": true } },

    { "op": "call", "method": "find.all", "args": [{ "text": "app", "matchPrefix": true }], "result": { "matches": [{ "text": "app" }, { "text": "app" }, { "text": "app", "after": "ly" }] } },
    { "op": "call", "method": "find.all", "args": [{ "text": "ple", "matchSuffix": true }], "result": { "matches": [{ "id": { "$type": "string" }, "before": "ap", "text": "ple", "after": " pie, re-apply", "page": 1 }] } },
    { "op": "call", "method": "find.all", "args": [{ "text": "reapply", "ignorePunctuation": true }], "result": { "matches": [{ "text": "re-apply" }] } },
    { "op": "call", "method": "find.all", "args": [{ "text": "applepie", "ignoreWhiteSpace": true }], "result": { "matches": [{ "text": "apple pie" }] } },

    { "op": "call", "method": "find.next", "args": [{ "text": "pie" }], "result": { "found": true } },
    { "op": "command", "command": { "type": "setBold", "value": true } },
    { "op": "call", "method": "find.all", "args": [{ "text": "", "format": { "font": { "style": "bold" } } }], "result": { "matches": [{ "id": { "$type": "string" }, "before": "apple ", "text": "pie", "after": ", re-apply", "page": 1 }] } },
    { "op": "call", "method": "find.replaceAll", "args": [{ "text": "end" }, "", { "font": { "style": "italic" } }], "result": { "count": 1 } },
    { "op": "call", "method": "find.all", "args": [{ "text": "end", "format": { "font": { "style": "italic" } } }], "result": { "matches": [{ "text": "end", "before": "The " }] } },

    { "op": "call", "method": "find.next", "args": [{ "text": "apple pie, re-apply" }], "result": { "found": true } },
    { "op": "call", "method": "find.all", "args": [{ "text": "apple", "inSelection": true }], "result": { "matches": [{ "id": { "$type": "string" }, "before": "", "text": "apple", "after": " pie, re-apply", "page": 1 }] } },
    { "op": "call", "method": "find.next", "args": [{ "text": "app", "inSelection": true }], "result": { "found": true, "wrapped": false } },
    { "op": "call", "method": "find.next", "args": [{ "text": "app", "inSelection": true }], "result": { "found": true, "wrapped": false } },

    { "op": "call", "method": "find.highlightAll", "args": [{ "text": "apple" }], "result": { "count": 2 } },
    { "op": "expectState", "match": { "view": { "findHighlights": true } } },
    { "op": "call", "method": "find.clearHighlights" },
    { "op": "expectState", "match": { "view": { "findHighlights": false } } },
    { "op": "call", "method": "find.highlightAll", "args": [{ "text": "apple" }], "result": { "count": 2 } },
    { "op": "command", "command": { "type": "moveSelection", "by": "document", "direction": "forward" } },
    { "op": "command", "command": { "type": "insertText", "value": "x" } },
    { "op": "expectState", "match": { "view": { "findHighlights": false } } },
    { "op": "call", "method": "find.highlightAll", "args": [{ "text": "zzz" }], "result": { "count": 0 } },
    { "op": "expectState", "match": { "view": { "findHighlights": false } } },

    { "op": "command", "command": { "type": "insertParagraph" } },
    { "op": "command", "command": { "type": "insertText", "value": "Pic " } },
    { "op": "command", "command": { "type": "insertPicture", "data": { "$file": "images/square-96.png" } } },
    { "op": "command", "command": { "type": "moveSelection", "by": "lineEdge", "direction": "forward" } },
    { "op": "command", "command": { "type": "insertText", "value": " end" } },
    { "op": "call", "method": "find.all", "args": [{ "text": "^g" }], "result": { "matches": [{ "before": "Pic " }] } },
    { "op": "call", "method": "find.replaceAll", "args": [{ "text": "Pic (.+) end", "regex": true }, "[$1]"], "result": { "count": 1 } },
    { "op": "call", "method": "find.all", "args": [{ "text": "^g" }], "result": { "matches": [{ "before": "[", "after": "]" }] } },
    { "op": "command", "command": { "type": "moveSelection", "by": "document", "direction": "forward" } },
    { "op": "command", "command": { "type": "insertPageBreak" } },
    { "op": "command", "command": { "type": "insertText", "value": "Next page." } },
    { "op": "command", "command": { "type": "insertSectionBreak", "value": "nextPage" } },
    { "op": "command", "command": { "type": "insertText", "value": "Last." } },
    { "op": "call", "method": "find.all", "args": [{ "text": "^12" }], "result": { "matches": [{}, {}] } },

    { "op": "command", "command": { "type": "setTrackChanges", "value": true } },
    { "op": "call", "method": "find.replaceAll", "args": [{ "text": "apple" }, "pear"], "result": { "count": 2 } },
    { "op": "expectState", "match": { "review": { "counts": { "all": { "insertions": 2, "deletions": 2 } } }, "history": { "undoLabel": "Replace All" } } },
    { "op": "command", "command": { "type": "undo" } },
    { "op": "call", "method": "find.all", "args": [{ "text": "pear" }], "result": { "matches": { "$exact": [] } } }
  ]
}
