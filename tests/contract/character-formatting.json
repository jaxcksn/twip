{
  "name": "character-formatting",
  "fixture": "editor/FX-STYLES.docx",
  "steps": [
    { "op": "open" },
    { "op": "command", "command": { "type": "selectAll" } },
    { "op": "command", "command": { "type": "setTypography", "scale": 90, "kerning": 12, "ligatures": "standardContextual", "numberSpacing": "tabular", "numberForm": "oldStyle", "stylisticSet": 2, "contextualAlternates": true } },
    { "op": "expectState", "match": { "formatting": { "scale": 90, "kerning": 12, "ligatures": "standardContextual", "numberSpacing": "tabular", "numberForm": "oldStyle", "stylisticSet": 2, "contextualAlternates": true } } },
    { "op": "command", "command": { "type": "setLanguage", "language": "en-GB", "noProof": true } },
    { "op": "expectState", "match": { "formatting": { "language": "en-GB", "noProof": true } } },
    { "op": "command", "command": { "type": "setCharacterEffects", "emboss": true, "shadow": true } },
    { "op": "expectState", "match": { "formatting": { "emboss": true, "engrave": false, "shadow": true, "outline": false } } },
    { "op": "command", "command": { "type": "setCharacterEffects", "engrave": true } },
    { "op": "expectState", "match": { "formatting": { "emboss": false, "engrave": true } } },
    { "op": "command", "command": { "type": "setUnderline", "value": "single" } },
    { "op": "command", "command": { "type": "setUnderlineColor", "value": "#C00000" } },
    { "op": "expectState", "match": { "formatting": { "underline": "single", "underlineColor": "#C00000" } } },
    { "op": "command", "command": { "type": "applyCharacterStyle", "value": "Emph" } },
    { "op": "expectState", "match": { "formatting": { "characterStyle": "Emph" } } },
    { "op": "command", "command": { "type": "applyCharacterStyle", "value": "Quote" } },
    { "op": "expectState", "match": { "formatting": { "characterStyle": "QuoteChar" } } },
    { "op": "command", "command": { "type": "applyCharacterStyle", "value": null } },
    { "op": "expectState", "match": { "formatting": { "characterStyle": "none" } } },
    { "op": "command", "command": { "type": "applyCharacterStyle", "value": "Normal" } },
    { "op": "expectError", "code": "invalid-argument" },
    { "op": "command", "command": { "type": "setParagraphStyle", "value": "Emph" } },
    { "op": "expectError", "code": "invalid-argument" },
    { "op": "command", "command": { "type": "setTypography", "stylisticSet": 21 } },
    { "op": "expectError", "code": "invalid-argument" },
    { "op": "command", "command": { "type": "undo" } },
    { "op": "expectState", "match": { "formatting": { "characterStyle": "QuoteChar" } } },
    { "op": "export", "format": "docx" },
    { "op": "reopen" },
    { "op": "command", "command": { "type": "selectAll" } },
    { "op": "expectState", "match": { "formatting": { "scale": 90, "ligatures": "standardContextual", "language": "en-GB", "engrave": true, "underlineColor": "#C00000", "characterStyle": "QuoteChar" } } }
  ]
}
