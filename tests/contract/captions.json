{
  "name": "captions",
  "fixture": "editor/FX-EMPTY.docx",
  "steps": [
    { "op": "open" },
    { "op": "call", "method": "references.captionLabels", "args": [["Plate"]], "result": { "$exact": ["Equation", "Figure", "Table", "Plate"] } },
    { "op": "command", "command": { "type": "insertText", "value": "Intro" } },
    { "op": "command", "command": { "type": "insertParagraph" } },
    { "op": "command", "command": { "type": "insertPicture", "data": { "$file": "images/square-96.png" } } },
    { "op": "expectState", "match": { "selection": { "kind": "object" } } },
    { "op": "command", "command": { "type": "insertCaption", "label": "Figure", "text": ": Square" } },
    { "op": "expectState", "match": { "history": { "undoLabel": "Insert Caption" } } },
    { "op": "call", "method": "references.crossReferenceTargets", "args": [{ "caption": "Figure" }], "result": { "$exact": [{ "text": "Figure 1: Square" }] } },
    { "op": "call", "method": "elements.list", "result": [{ "kind": "field", "code": " SEQ Figure \\* ARABIC ", "display": "1" }] },

    { "op": "command", "command": { "type": "moveSelection", "by": "document", "direction": "forward" } },
    { "op": "command", "command": { "type": "insertParagraph" } },
    { "op": "command", "command": { "type": "insertTable", "rows": 2, "columns": 2 } },
    { "op": "command", "command": { "type": "insertCaption", "label": "Table", "format": "upperRoman" } },
    { "op": "call", "method": "references.crossReferenceTargets", "args": [{ "caption": "Table" }], "result": { "$exact": [{ "text": "Table I" }] } },
    { "op": "command", "command": { "type": "insertCaption", "label": "Table", "format": "ordinal" } },
    { "op": "expectError", "code": "invalid-argument" },

    { "op": "command", "command": { "type": "moveSelection", "by": "document", "direction": "backward" } },
    { "op": "command", "command": { "type": "insertCaption", "label": "Figure", "text": " first", "position": "below" } },
    { "op": "call", "method": "references.crossReferenceTargets", "args": [{ "caption": "Figure" }], "result": { "$exact": [{ "text": "Figure 1 first" }, { "text": "Figure 2: Square" }] } },
    { "op": "command", "command": { "type": "insertCaption", "label": "1abc" } },
    { "op": "expectError", "code": "invalid-argument" },
    { "op": "command", "command": { "type": "insertCaption", "label": "Figure", "chapter": { "level": 12, "separator": "hyphen" } } },
    { "op": "expectError", "code": "invalid-argument" },
    { "op": "command", "command": { "type": "insertCaption", "label": "My Plate" } },
    { "op": "call", "method": "references.crossReferenceTargets", "args": [{ "caption": "My Plate" }], "result": { "$exact": [{ "text": "My Plate 1" }] } },
    { "op": "call", "method": "elements.list", "result": { "$has": [{ "code": " SEQ My_Plate \\* ARABIC " }] } },
    { "op": "call", "method": "references.captionLabels", "args": [["Plate"]], "result": { "$exact": ["Equation", "Figure", "Table", "Plate", "My Plate"] } },

    { "op": "command", "command": { "type": "setAutoCaption", "value": { "label": "Table", "position": "above" } } },
    { "op": "expectState", "match": { "autoCaption": { "label": "Table", "position": "above" } } },
    { "op": "command", "command": { "type": "setAutoCaption", "value": { "label": "9x" } } },
    { "op": "expectError", "code": "invalid-argument" },
    { "op": "command", "command": { "type": "moveSelection", "by": "document", "direction": "forward" } },
    { "op": "command", "command": { "type": "insertParagraph" } },
    { "op": "command", "command": { "type": "insertTable", "rows": 1, "columns": 1 } },
    { "op": "expectState", "match": { "selection": { "table": { "rows": 1 } } } },
    { "op": "call", "method": "references.crossReferenceTargets", "args": [{ "caption": "Table" }], "result": { "$exact": [{ "text": "Table I" }, { "text": "Table 2" }] } },
    { "op": "command", "command": { "type": "undo" } },
    { "op": "call", "method": "references.crossReferenceTargets", "args": [{ "caption": "Table" }], "result": { "$exact": [{ "text": "Table I" }] } },
    { "op": "command", "command": { "type": "setAutoCaption", "value": null } },
    { "op": "expectState", "match": { "autoCaption": null } },
    { "op": "call", "method": "setReadOnly", "args": [true] },
    { "op": "command", "command": { "type": "setAutoCaption", "value": { "label": "Table" } } },
    { "op": "expectState", "match": { "autoCaption": { "label": "Table" } } },
    { "op": "call", "method": "setReadOnly", "args": [false] },
    { "op": "command", "command": { "type": "setAutoCaption", "value": null } },

    { "op": "command", "command": { "type": "moveSelection", "by": "document", "direction": "forward" } },
    { "op": "command", "command": { "type": "insertTableOfFigures", "label": "Figure" } },
    { "op": "expectState", "match": { "history": { "undoLabel": "Insert Table of Figures" } } },
    { "op": "call", "method": "references.tablesOfContents", "result": { "tables": [{ "figures": true, "options": { "$exact": { "captions": { "label": "Figure", "includeLabelAndNumber": true }, "hyperlinks": true, "hideInWebView": true } } }] } },
    { "op": "call", "method": "references.tocEntries", "args": [{ "captions": { "label": "Figure", "includeLabelAndNumber": false } }], "result": { "$exact": [{ "level": 1, "text": "first", "pageNumber": true }, { "level": 1, "text": "Square", "pageNumber": true }] } },
    { "op": "command", "command": { "type": "moveSelection", "by": "document", "direction": "backward" } },
    { "op": "command", "command": { "type": "insertTableOfFigures", "label": "Figure", "includeLabelAndNumber": false } },
    { "op": "call", "method": "references.tablesOfContents", "result": { "tables": { "$has": [{ "figures": true, "options": { "captions": { "includeLabelAndNumber": true } } }, { "figures": true, "options": { "captions": { "includeLabelAndNumber": false } } }] } } }
  ]
}
