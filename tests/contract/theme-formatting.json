{
  "name": "theme-formatting",
  "fixture": "editor/FX-EMPTY.docx",
  "steps": [
    {"op": "open"},
    {"op": "command", "command": {"type": "insertText", "value": "Theme colours and fonts"}},
    {"op": "command", "command": {"type": "selectAll"}},
    {"op": "command", "command": {"type": "setFontColor", "value": {"theme": "accent1", "transforms": [{"kind": "tint", "value": 0.4}]}}},
    {"op": "expectState", "match": {"formatting": {"color": {"$type": "string"}, "colorValue": {"theme": "accent1", "transforms": [{"kind": "tint"}]}}}},
    {"op": "command", "command": {"type": "setFontColor", "value": {"theme": "accent1", "transforms": [{"kind": "tint", "value": 0.4}, {"kind": "shade", "value": 0.5}]}}},
    {"op": "expectError", "code": "invalid-argument"},
    {"op": "command", "command": {"type": "setFontColor", "value": "#C00000"}},
    {"op": "expectState", "match": {"formatting": {"color": "#C00000", "colorValue": {"rgb": "#C00000"}}}},
    {"op": "command", "command": {"type": "setFont", "value": {"theme": "headings"}}},
    {"op": "expectState", "match": {"formatting": {"fontTheme": "headings"}}},
    {"op": "command", "command": {"type": "setFont", "value": "Carlito"}},
    {"op": "expectState", "match": {"formatting": {"fontTheme": "none", "font": "Carlito"}}},
    {"op": "command", "command": {"type": "setTextBorder", "border": {"style": "single", "width": 0.5, "color": "auto", "space": 2, "shadow": true}}},
    {"op": "expectState", "match": {"formatting": {"textBorder": {"style": "single", "space": 2, "shadow": true}}}},
    {"op": "command", "command": {"type": "setShading", "target": "text", "fill": {"theme": "accent2"}, "pattern": "clear"}},
    {"op": "expectState", "match": {"formatting": {"textShading": {"fill": {"theme": "accent2"}, "pattern": "clear"}}}},
    {"op": "command", "command": {"type": "setTypography", "ligatureFlags": {"standard": true, "discretionary": true}, "stylisticSets": [3, 1]}},
    {"op": "expectState", "match": {"formatting": {"ligatureFlags": {"standard": true, "contextual": false, "historical": false, "discretionary": true}, "stylisticSets": [1, 3]}}},
    {"op": "command", "command": {"type": "setTypography", "stylisticSets": [21]}},
    {"op": "expectError", "code": "invalid-argument"},
    {"op": "command", "command": {"type": "setFitText", "value": 120}},
    {"op": "expectState", "match": {"formatting": {"fitText": 120}, "history": {"undoLabel": "Fit Text"}}},
    {"op": "command", "command": {"type": "setFitText", "value": null}},
    {"op": "expectState", "match": {"formatting": {"fitText": "none"}}},
    {"op": "command", "command": {"type": "setParagraphBorderLines", "top": {"style": "double", "width": 0.75, "color": {"theme": "text2", "transforms": [{"kind": "shade", "value": 0.75}]}, "space": 4}}},
    {"op": "expectState", "match": {"paragraph": {"borderTop": {"style": "double", "space": 4, "color": {"theme": "text2"}}, "borderBottom": "none"}}},
    {"op": "command", "command": {"type": "setParagraphShading", "value": {"theme": "accent6"}}},
    {"op": "expectState", "match": {"paragraph": {"shadingValue": {"fill": {"theme": "accent6"}, "pattern": "clear"}}}},
    {"op": "command", "command": {"type": "setPageBorders", "top": {"style": "single", "width": 1, "color": {"theme": "accent1"}, "space": 20}, "behindText": true}},
    {"op": "expectState", "match": {"page": {"pageBorders": {"top": {"style": "single", "space": 20, "color": {"theme": "accent1"}}, "behindText": true}}}},
    {"op": "command", "command": {"type": "setMargins", "left": 90, "applyTo": "wholeDocument"}},
    {"op": "expectState", "match": {"page": {"margins": {"left": 90}}, "history": {"undoLabel": "Margins"}}},
    {"op": "call", "method": "wordCount", "args": [{"selection": true}], "result": {"words": 4}},
    {"op": "call", "method": "wordCount", "result": {"words": 4, "paragraphs": 1}},
    {"op": "call", "method": "themeColourGrid", "result": [{"theme": "background1", "swatches": [{"label": "Background 1"}, {"label": {"$type": "string"}}, {}, {}, {}, {}]}, {"theme": "text1"}, {"theme": "background2"}, {"theme": "text2"}, {"theme": "accent1"}, {"theme": "accent2"}, {"theme": "accent3"}, {"theme": "accent4"}, {"theme": "accent5"}, {"theme": "accent6"}]},
    {"op": "expectState", "match": {"themeFonts": {"heading": {"$type": "string"}, "body": {"$type": "string"}}}},
    {"op": "command", "command": {"type": "moveSelection", "by": "document", "direction": "forward"}},
    {"op": "command", "command": {"type": "insertLineBreak", "clear": "both"}},
    {"op": "expectState", "match": {"history": {"undoLabel": "Text Wrapping Break"}}},
    {"op": "command", "command": {"type": "insertPageNumber", "format": "page", "where": {"margin": {"side": "outside"}}}},
    {"op": "expectState", "match": {"history": {"undoLabel": "Page Number"}}}
  ]
}
