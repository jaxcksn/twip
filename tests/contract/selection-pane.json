{
  "name": "selection-pane",
  "fixture": "editor/FX-OBJ.docx",
  "steps": [
    { "op": "open" },
    { "op": "command", "command": { "type": "selectNextObject", "value": "next" } },
    { "op": "expectState", "match": { "selection": { "object": { "kind": "picture", "name": "Picture 5", "hidden": false, "pictureAdjust": { "recolor": { "kind": "none" } } } } } },
    { "op": "call", "method": "objectList", "args": [0] },
    { "op": "command", "command": { "type": "setObjectName", "value": "Gold star" } },
    { "op": "command", "command": { "type": "setObjectTitle", "value": "Logo" } },
    { "op": "command", "command": { "type": "setLockAspectRatio", "value": true } },
    { "op": "expectState", "match": { "selection": { "object": { "name": "Gold star", "title": "Logo", "lockAspect": true } } } },
    { "op": "command", "command": { "type": "setObjectName", "value": "   " } },
    { "op": "expectError", "code": "unavailable" },
    { "op": "command", "command": { "type": "setPictureRecolor", "value": { "kind": "blackAndWhite", "threshold": 0.5 } } },
    { "op": "expectState", "match": { "selection": { "object": { "pictureAdjust": { "recolor": { "kind": "blackAndWhite", "threshold": 0.5 } } } } } },
    { "op": "command", "command": { "type": "setPictureRecolor", "value": { "kind": "blackAndWhite", "threshold": 2 } } },
    { "op": "expectError", "code": "invalid-argument" },
    { "op": "command", "command": { "type": "resetPicture" } },
    { "op": "expectState", "match": { "selection": { "object": { "pictureAdjust": { "recolor": { "kind": "none" } } } } } },
    { "op": "command", "command": { "type": "undo" } },
    { "op": "export", "format": "docx" },
    { "op": "reopen" },
    { "op": "command", "command": { "type": "selectNextObject", "value": "next" } },
    { "op": "expectState", "match": { "selection": { "object": { "name": "Gold star", "title": "Logo", "lockAspect": true, "pictureAdjust": { "recolor": { "kind": "blackAndWhite", "threshold": 0.5 } } } } } },
    { "op": "command", "command": { "type": "setSelectObjects", "value": true } },
    { "op": "expectState", "match": { "view": { "selectingObjects": true }, "commands": { "setSelectObjects": { "checked": true } } } },
    { "op": "key", "key": "Escape" },
    { "op": "expectState", "match": { "view": { "selectingObjects": false } } },
    { "op": "command", "command": { "type": "setTableTool", "value": "pen" } },
    { "op": "expectState", "match": { "view": { "tableTool": "pen", "tablePen": { "style": "single", "width": 0.5 } } } },
    { "op": "command", "command": { "type": "setTablePen", "value": { "style": "double", "width": 1.5, "color": "auto" } } },
    { "op": "expectState", "match": { "view": { "tablePen": { "style": "double", "width": 1.5 } } } },
    { "op": "command", "command": { "type": "setTablePen", "value": { "style": "single", "width": 9, "color": "auto" } } },
    { "op": "expectError", "code": "invalid-argument" },
    { "op": "key", "key": "Escape" },
    { "op": "expectState", "match": { "view": { "tableTool": "none" } } }
  ]
}
