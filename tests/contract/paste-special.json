{
  "name": "paste-special",
  "fixture": "editor/FX-EMPTY.docx",
  "steps": [
    { "op": "open" },
    { "op": "call", "method": "pasteChoices", "args": [{ "text": "t", "html": "<p>t</p>", "image": { "mime": "image/png", "data": { "$file": "images/square-96.png" } } }],
      "result": { "choices": { "$exact": ["keepSource", "merge", "textOnly", "html", "text", "picture"] }, "default": "keepSource" } },
    { "op": "call", "method": "pasteChoices", "args": [{ "text": "", "image": { "mime": "image/png", "data": { "$file": "images/square-96.png" } } }], "result": { "choices": ["picture"], "default": "picture" } },
    { "op": "call", "method": "pasteChoices", "args": [{ "text": "" }], "result": { "choices": { "$exact": [] }, "default": null } },
    { "op": "command", "command": { "type": "insertTable", "rows": 3, "columns": 2 } },
    { "op": "command", "command": { "type": "insertText", "value": "A1" } },
    { "op": "command", "command": { "type": "moveToCell", "value": "next" } },
    { "op": "command", "command": { "type": "insertText", "value": "B1" } },
    { "op": "command", "command": { "type": "select", "value": "row" } },
    { "op": "call", "method": "copyContent", "save": "row" },
    { "op": "command", "command": { "type": "moveToCell", "value": "next" } },
    { "op": "call", "method": "pasteChoices", "args": [{ "$saved": "row" }],
      "result": { "choices": { "$exact": ["nestTable", "mergeTable", "insertRows", "overwriteCells", "textOnly", "html", "text"] }, "default": "overwriteCells" } },
    { "op": "expectEvents", "match": [] },
    { "op": "call", "method": "pasteContent", "args": [{ "$saved": "row" }] },
    { "op": "expectEvents", "match": [{ "type": "popoverRequested", "kind": "pasteOptions", "current": "overwriteCells", "choices": { "$exact": ["nestTable", "mergeTable", "insertRows", "overwriteCells", "textOnly"] } }] },
    { "op": "expectState", "match": { "history": { "undoLabel": "Paste Cells" } } },
    { "op": "command", "command": { "type": "repaste", "value": "insertRows" } },
    { "op": "expectState", "match": { "history": { "undoLabel": "Paste Rows" }, "selection": { "table": { "rows": 4 } } } },
    { "op": "command", "command": { "type": "undo" } },
    { "op": "command", "command": { "type": "setPasteOptions", "smart": { "tables": false } } },
    { "op": "call", "method": "pasteContent", "args": [{ "$saved": "row" }] },
    { "op": "expectEvents", "match": [{ "type": "popoverRequested", "kind": "pasteOptions", "current": "nestTable" }] },
    { "op": "command", "command": { "type": "undo" } },
    { "op": "command", "command": { "type": "setPasteOptions", "smart": { "tables": true }, "other": "merge" } },
    { "op": "command", "command": { "type": "moveSelection", "by": "document", "direction": "forward" } },
    { "op": "call", "method": "pasteContent", "args": [{ "text": "plain" }] },
    { "op": "expectEvents", "match": [{ "type": "popoverRequested", "kind": "pasteOptions", "current": "textOnly" }] },
    { "op": "call", "method": "find.all", "args": [{ "text": "plain" }], "result": { "matches": [{}] } },
    { "op": "call", "method": "setReadOnly", "args": [true] },
    { "op": "call", "method": "pasteChoices", "args": [{ "text": "t" }], "result": { "choices": { "$exact": [] } } }
  ]
}
