{
  "name": "go-to",
  "fixture": "editor/FX-EMPTY.docx",
  "steps": [
    { "op": "open" },
    { "op": "command", "command": { "type": "insertText", "value": "Alpha intro" } },
    { "op": "command", "command": { "type": "setParagraphStyle", "value": "Heading1" } },
    { "op": "command", "command": { "type": "insertParagraph" } },
    { "op": "command", "command": { "type": "insertText", "value": "Bravo line one" } },
    { "op": "command", "command": { "type": "insertLineBreak" } },
    { "op": "command", "command": { "type": "insertText", "value": "Charlie line two" } },
    { "op": "command", "command": { "type": "insertPageBreak" } },
    { "op": "command", "command": { "type": "insertText", "value": "Delta page two " } },
    { "op": "command", "command": { "type": "insertField", "code": "PAGE" } },
    { "op": "command", "command": { "type": "insertSectionBreak", "value": "nextPage" } },
    { "op": "command", "command": { "type": "insertText", "value": "Echo section two" } },
    { "op": "command", "command": { "type": "setParagraphStyle", "value": "Heading2" } },
    { "op": "command", "command": { "type": "insertParagraph" } },
    { "op": "command", "command": { "type": "insertTable", "rows": 2, "columns": 2 } },
    { "op": "command", "command": { "type": "moveSelection", "by": "document", "direction": "backward" } },
    { "op": "expectState", "match": { "pages": { "count": 3 } } },

    { "op": "command", "command": { "type": "goTo", "what": "page", "target": { "absolute": 2 } } },
    { "op": "command", "command": { "type": "select", "value": "word" } },
    { "op": "expectState", "match": { "selection": { "page": 2, "text": "Delta " } } },
    { "op": "command", "command": { "type": "goTo", "what": "page", "target": { "absolute": 99 } } },
    { "op": "command", "command": { "type": "select", "value": "word" } },
    { "op": "expectState", "match": { "selection": { "page": 3, "text": "Echo " } } },
    { "op": "command", "command": { "type": "goTo", "what": "page", "target": "next" } },
    { "op": "expectError", "code": "unavailable" },
    { "op": "command", "command": { "type": "goTo", "what": "page", "target": { "absolute": 0 } } },
    { "op": "expectError", "code": "invalid-argument" },
    { "op": "command", "command": { "type": "goTo", "what": "line", "target": { "relative": 0 } } },
    { "op": "expectError", "code": "invalid-argument" },
    { "op": "command", "command": { "type": "goTo", "what": "page", "target": { "relative": -1 } } },
    { "op": "command", "command": { "type": "select", "value": "word" } },
    { "op": "expectState", "match": { "selection": { "page": 2, "text": "Delta " } } },

    { "op": "command", "command": { "type": "goTo", "what": "section", "target": { "absolute": 2 } } },
    { "op": "command", "command": { "type": "select", "value": "word" } },
    { "op": "expectState", "match": { "selection": { "page": 3, "text": "Echo " } } },
    { "op": "command", "command": { "type": "goTo", "what": "section", "target": "previous" } },
    { "op": "command", "command": { "type": "select", "value": "word" } },
    { "op": "expectState", "match": { "selection": { "page": 1, "text": "Alpha " } } },

    { "op": "command", "command": { "type": "goTo", "what": "line", "target": { "absolute": 3 } } },
    { "op": "command", "command": { "type": "select", "value": "word" } },
    { "op": "expectState", "match": { "selection": { "text": "Charlie " } } },
    { "op": "command", "command": { "type": "goTo", "what": "line", "target": { "relative": -1 } } },
    { "op": "command", "command": { "type": "select", "value": "word" } },
    { "op": "expectState", "match": { "selection": { "text": "Bravo " } } },

    { "op": "command", "command": { "type": "goTo", "what": "field", "target": "next", "name": "page" } },
    { "op": "expectState", "match": { "selection": { "page": 2, "empty": false } } },
    { "op": "command", "command": { "type": "goTo", "what": "field", "target": "next", "name": "DATE" } },
    { "op": "expectError", "code": "unavailable" },
    { "op": "command", "command": { "type": "goTo", "what": "table", "target": { "absolute": 1 } } },
    { "op": "expectState", "match": { "selection": { "page": 3, "table": { "$type": "object" } } } },
    { "op": "command", "command": { "type": "goTo", "what": "heading", "target": "previous" } },
    { "op": "command", "command": { "type": "select", "value": "word" } },
    { "op": "expectState", "match": { "selection": { "text": "Echo " } } },
    { "op": "command", "command": { "type": "goTo", "what": "heading", "target": { "absolute": 1 } } },
    { "op": "command", "command": { "type": "select", "value": "word" } },
    { "op": "expectState", "match": { "selection": { "text": "Alpha " } } },
    { "op": "command", "command": { "type": "goTo", "what": "bookmark", "target": { "absolute": 1 }, "name": "Nowhere" } },
    { "op": "expectError", "code": "invalid-argument" },
    { "op": "command", "command": { "type": "goTo", "what": "comment", "target": "next" } },
    { "op": "expectError", "code": "unavailable" },

    { "op": "call", "method": "find.next", "args": [{ "text": "Bravo" }] },
    { "op": "command", "command": { "type": "addComment", "value": "Check this" } },
    { "op": "command", "command": { "type": "moveSelection", "by": "document", "direction": "forward" } },
    { "op": "command", "command": { "type": "goTo", "what": "comment", "target": "previous" } },
    { "op": "expectState", "match": { "selection": { "text": "Bravo" } } },
    { "op": "command", "command": { "type": "moveSelection", "by": "document", "direction": "forward" } },
    { "op": "command", "command": { "type": "goTo", "what": "comment", "target": "previous", "name": "Nobody" } },
    { "op": "expectError", "code": "unavailable" },

    { "op": "call", "method": "find.next", "args": [{ "text": "Charlie" }] },
    { "op": "command", "command": { "type": "moveSelection", "by": "lineEdge", "direction": "forward" } },
    { "op": "command", "command": { "type": "insertFootnote" } },
    { "op": "command", "command": { "type": "moveSelection", "by": "document", "direction": "backward" } },
    { "op": "command", "command": { "type": "goTo", "what": "footnote", "target": "next" } },
    { "op": "expectState", "match": { "selection": { "story": "body", "empty": true, "page": 1 } } }
  ]
}
